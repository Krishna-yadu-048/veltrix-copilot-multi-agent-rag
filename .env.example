# Copy to .env and adjust.  .env is git-ignored — never commit it.

# --- Local LLM (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
# Qwen3-4B-Instruct-2507: the NON-thinking Qwen3 build (never writes <think> blocks; faster on 4 GB).
# The plain `qwen3:4b` tag may be a thinking model that reasons before every answer.
CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
NUM_CTX=4096
# qwen3 has a "thinking" mode; disabling it makes answers much faster on a 4 GB GPU
DISABLE_THINKING=true
# Run embeddings on CPU so the chat model keeps the whole GPU
EMBED_ON_CPU=true
LLM_TIMEOUT_SECONDS=240

# --- Database (Postgres + pgvector in Docker, bound to localhost only) ---
DATABASE_URL=postgresql://app:app@127.0.0.1:5433/veltrix

# --- MCP tool servers (bound to 127.0.0.1) ---
MCP_TRAVEL_URL=http://127.0.0.1:8101/mcp
MCP_EMAIL_URL=http://127.0.0.1:8102/mcp
MCP_CALENDAR_URL=http://127.0.0.1:8103/mcp
# Email drafts may only be addressed to these domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=veltrix.io

# --- Calendar: your Google Calendar (required; run scripts/google_auth.py once) ---
# A dedicated calendar is recommended (create "Veltrix Copilot" in Google Calendar, copy its ID
# from Settings -> Integrate calendar). "primary" = your main calendar.
GOOGLE_CALENDAR_ID=primary
TIMEZONE=Asia/Kolkata
# GOOGLE_CLIENT_SECRET_FILE=secrets/google_client_secret.json
# GOOGLE_TOKEN_FILE=secrets/google_token.json

# --- Travel data: live Google Flights / Hotels via SerpAPI (required for trip planning) ---
SERPAPI_API_KEY=
# Cost guards: max live searches per month (free plan: 250), searches to keep in reserve,
# and how long identical searches are answered from the local cache (cached = free).
SERPAPI_MONTHLY_LIMIT=100
SERPAPI_MIN_SEARCHES_LEFT=20
SERPAPI_CACHE_HOURS=24
# Country for prices/availability (two-letter code)
SERPAPI_GL=in

# --- RAG ---
RAG_TOP_K=4
# Cosine distance above which a question is treated as "not in the documents" 
RAG_MAX_DISTANCE=0.55

# --- Orchestrator ---
# When a follow-up like "add it to the calendar" is unclear, let the model decide (one short call
# that sees a one-line summary, not the chat history). false = always ask "Do you mean your trip…?"
USE_LLM_FOLLOWUPS=true
REQUEST_TIMEOUT_SECONDS=300

# --- Personal defaults ---
HOME_CITY=Kochi
# Trip costs are calculated in USD (company policy) and also shown in your home currency
# and the destination's currency. Empty = derived from HOME_CITY (Kochi -> INR).
HOME_CURRENCY=
MANAGER_EMAIL=manager@veltrix.io
USER_NAME=Your Name

# --- API (used by the Streamlit UI) ---
API_URL=http://127.0.0.1:8000
